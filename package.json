{
  "name": "multi-stream-studio",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "20.x"
  },
  "type": "module",
  "description": "Multi Stream Studio - browser-based live production studio UI",
"scripts": {
  "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node server.mjs\"",
  "build": "tsc -b && vite build",
  "start": "node server.mjs",
  "preview": "vite preview",
  "lint": "tsc --noEmit"
},
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "electron": "latest",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
