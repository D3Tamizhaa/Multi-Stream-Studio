/* Multi Stream Studio — broadcast-console visual language.
   Dark graphite surfaces (this runs next to a video feed - a bright
   chrome would wreck color judgement), a single blue accent for
   interactive/active state, and red reserved strictly for "live".
   Monospace is used only where it is functionally a readout
   (uptime, bitrate figures) - never as UI decoration. */

:root {
  --bg-base: #14161a;
  --bg-panel: #1b1e25;
  --bg-panel-raised: #242832;
  --bg-inset: #101216;
  --border: #333847;
  --border-soft: #262a34;
  --text-primary: #e8eaed;
  --text-muted: #8b93a3;
  --text-faint: #5b6474;
  --accent: #4f8ef7;
  --accent-dim: #2c5dc1;
  --live: #e5484d;
  --live-dim: #7a2326;
  --success: #35c377;
  --radius: 3px;
  --gap: 12px;
  font-size: 15px;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  height: 100%;
  background: var(--bg-base);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }

button {
  font-family: inherit;
  cursor: pointer;
}

input, select, textarea, button {
  font-size: 14px;
  color: var(--text-primary);
  background: var(--bg-inset);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 7px 9px;
}

input:focus, select:focus, textarea:focus, button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}

label {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 13px;
  color: var(--text-muted);
}

.btn {
  background: var(--bg-panel-raised);
  border: 1px solid var(--border);
  padding: 8px 14px;
  border-radius: var(--radius);
  color: var(--text-primary);
  font-weight: 600;
}
.btn:hover { border-color: var(--accent); }
.btn-primary { background: var(--accent-dim); border-color: var(--accent); }
.btn-primary:hover { background: var(--accent); }
.btn-danger { background: var(--live-dim); border-color: var(--live); }
.btn-danger:hover { background: var(--live); }
.btn-block { width: 100%; }
.btn-icon {
  background: transparent;
  border: none;
  padding: 4px 6px;
  font-size: 15px;
  color: var(--text-muted);
}
.btn-icon:hover { color: var(--text-primary); }
.btn-sm { padding: 4px 8px; font-size: 12px; }

.error-text { color: var(--live); font-size: 13px; }
.hint { color: var(--text-faint); font-size: 12px; }

/* ---------- Login ---------- */
.login-body {
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-card {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  padding: 32px;
  width: 320px;
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.login-title {
  font-size: 19px;
  margin: 0 0 8px;
  letter-spacing: 0.2px;
}

/* ---------- App shell ---------- */
#app-header {
  height: 52px;
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 14px;
  gap: 14px;
  position: sticky;
  top: 0;
  z-index: 20;
}
#app-title {
  font-weight: 700;
  font-size: 16px;
  flex: 1;
  text-align: center;
  letter-spacing: 0.3px;
}
#user-menu { display: flex; align-items: center; gap: 8px; }

#side-menu {
  position: fixed;
  top: 52px;
  left: 0;
  bottom: 0;
  width: 220px;
  background: var(--bg-panel);
  border-right: 1px solid var(--border);
  z-index: 30;
  padding: 10px 0;
  overflow-y: auto;
}
#side-menu ul { list-style: none; margin: 0; padding: 0; }
#side-menu li { padding: 10px 18px; font-size: 14px; color: var(--text-muted); cursor: pointer; }
#side-menu li:hover { color: var(--text-primary); background: var(--bg-panel-raised); }
#side-menu .menu-group { cursor: default; color: var(--text-faint); font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; padding-bottom: 4px; }
#side-menu .menu-group > ul li { padding-left: 18px; color: var(--text-muted); font-size: 14px; text-transform: none; letter-spacing: 0; }
#menu-backdrop {
  position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 25;
}

main.view { max-width: 1240px; margin: 0 auto; padding: 16px; padding-bottom: 60px; }
.settings-view { max-width: 640px; }
.settings-view h2 { font-size: 17px; margin-top: 0; }
.settings-view .field-row { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.settings-view .actions { display: flex; gap: 10px; margin-top: 18px; }
.settings-view .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

/* ---------- Workspace ---------- */
#workspace-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 8px;
  margin-bottom: var(--gap);
}
#workspace-container {
  position: relative;
  width: 100%;
  max-width: 960px;
}
#workspace {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background: repeating-conic-gradient(#20232b 0% 25%, #191c22 0% 50%) 50% / 24px 24px;
  border: 1px solid var(--border);
  overflow: hidden;
  border-radius: var(--radius);
}
#workspace.preview-mode { border-color: var(--success); }
.ws-source {
  position: absolute;
  border: 1px dashed var(--accent);
  cursor: move;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  user-select: none;
}
.ws-source.locked { cursor: not-allowed; border-color: var(--text-faint); }
.ws-source.selected { border-color: var(--success); box-shadow: 0 0 0 1px var(--success); }
#workspace.preview-mode .ws-source { border: none; }
.ws-source img, .ws-source video { width: 100%; height: 100%; object-fit: fill; pointer-events: none; }
.ws-source .ws-text { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; pointer-events: none; white-space: nowrap; }
.ws-handle {
  position: absolute;
  right: -5px; bottom: -5px;
  width: 10px; height: 10px;
  background: var(--accent);
  border-radius: 2px;
  cursor: nwse-resize;
}
#workspace.preview-mode .ws-handle { display: none; }

#preview-toggle {
  position: relative;
  top: 100%;
  transform: translateY(calc(-100% - -8px));
  margin-left: -44px;
  width: 34px;
  height: 34px;
  border-radius: var(--radius);
  background: var(--bg-panel-raised);
  border: 1px solid var(--border);
  align-self: flex-end;
}
#preview-toggle.active { border-color: var(--success); color: var(--success); }

/* ---------- Panels grid ---------- */
#production-panels, #streaming-controls {
  display: grid;
  gap: var(--gap);
  margin-bottom: var(--gap);
}
#production-panels { grid-template-columns: 1fr 1fr 1fr; }
#streaming-controls { grid-template-columns: 1fr 1fr; }

.panel {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  min-height: 180px;
}
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 10px;
  border-bottom: 1px solid var(--border-soft);
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 0.4px;
}
.panel-header .actions { display: flex; gap: 2px; }
.panel-list { list-style: none; margin: 0; padding: 4px; flex: 1; overflow-y: auto; max-height: 220px; }
.panel-list li {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px;
  border-radius: var(--radius);
  font-size: 13px;
}
.panel-list li:hover { background: var(--bg-panel-raised); }
.panel-list li.active { background: var(--accent-dim); }
.panel-list li .item-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: default; }
.panel-list li.selectable .item-name { cursor: pointer; }
.panel-list .row-actions { display: flex; gap: 2px; }
.panel-empty { color: var(--text-faint); font-size: 12px; padding: 16px 10px; text-align: center; }

.mixer-strip { padding: 8px 10px; border-bottom: 1px solid var(--border-soft); }
.mixer-strip .mixer-name { font-size: 13px; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center;}
.mixer-strip input[type="range"] { width: 100%; }

/* ---------- Controls / Status ---------- */
#panel-controls .controls-body { padding: 16px; display: flex; flex-direction: column; gap: 10px; justify-content: center; flex: 1;}

#status-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 34px;
  background: var(--bg-panel);
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 0 16px;
  font-size: 13px;
  z-index: 15;
}
#status-bar .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--text-faint); display: inline-block; margin-right: 6px; }
#status-bar.live .status-dot { background: var(--live); box-shadow: 0 0 6px var(--live); }
#status-bar.live #stream-status { color: var(--live); font-weight: 700; }

/* ---------- Modal ---------- */
.modal-backdrop {
  position: fixed; inset: 0; background: rgba(0,0,0,0.55);
  display: flex; align-items: center; justify-content: center; z-index: 50;
}
.modal {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  width: 380px;
  max-width: 92vw;
  max-height: 86vh;
  overflow-y: auto;
  padding: 18px;
}
.modal h3 { margin-top: 0; font-size: 15px; }
.modal .field-row { display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px; }
.modal .tabs { display: flex; gap: 4px; margin-bottom: 14px; }
.modal .tabs button { flex: 1; }
.modal .tabs button.active { background: var(--accent-dim); border-color: var(--accent); }
.modal .actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 6px; }
.progress-bar { height: 6px; background: var(--bg-inset); border-radius: 3px; overflow: hidden; margin-top: 6px; }
.progress-bar .fill { height: 100%; width: 0%; background: var(--accent); }

@media (max-width: 880px) {
  #production-panels, #streaming-controls { grid-template-columns: 1fr; }
  .settings-view .two-col { grid-template-columns: 1fr; }
}
